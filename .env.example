# GitHub Personal Access Token (repo + metadata scopes required)
# Generate at: https://github.com/settings/tokens
TOKEN=ghp_your_token_here

# Your GitHub username for fetching contributions
GITHUB_USER=your_github_username

# Repository path where commits will be created (format: owner/repo or just repo if owned by GITHUB_USER)
GITHUB_REPO=your_repository_name

# Name to use as author for commits
GIT_NAME=Your Display Name

# Email to use as author for commits
GIT_EMAIL=you@example.com
